    "right": { "do_fwd": 3, "do_rev": 4, "do_brake": 5, "do_alarm": 888, "ao_speed": 1 }
  },

  "hardware": {
    "V_RANGE": 10.0,
    "DAC_RES": 4095,
    "_comment_cal": "Per-wheel motor cal from encoder run 2026-05-30 (rpm=RPM_PER_VOLT*V+OFFSET, R2=0.99 for V>=0.55). Old single fit 646.59/-101.2 was ~2x too low. Shared keys kept as fallback.",
    "RPM_PER_VOLT": 1265.7,
    "RPM_VOLT_OFFSET": -321.4,
    "RPM_PER_VOLT_LEFT": 1269.8,
    "RPM_VOLT_OFFSET_LEFT": -354.2,
    "RPM_PER_VOLT_RIGHT": 1289.8,
    "RPM_VOLT_OFFSET_RIGHT": -299.1
  },

  "kinematics": {
    "WHEEL_DIAMETER": 0.18,
    "GEAR_RATIO": 30
  },

  "speeds": {
    "MANUAL_TARGET_HIGH_SPEED": 0.5,
    "MANUAL_TARGET_SLOW_SPEED": 0.25,
    "AUTO_TARGET_HIGH_SPEED": 0.20,
    "AUTO_TARGET_SLOW_SPEED": 0.12,
    "AUTO_TARGET_EXTRA_SLOW_SPEED": 0.12,
    "ACCEL_RATE": 0.8
  },

  "pid_tuning": {
    "_comment_high": "HIGH speed gains — retuned: less speed-reduction crawl, tighter tracking + more damping (heavier AGV, 0.20m/s baseline)",
    "KP": 1.5,
    "TD": 0.22,
    "N": 20,
    "_comment_slow": "SLOW gains — retuned for 0.12m/s",
    "KP_SLOW": 1.5,
    "TD_SLOW": 0.14,
    "N_SLOW": 12,
    "_comment_extra_slow": "EXTRA_SLOW gains — tuned for 0.10m/s, gentle straight-line following for sequence approach",
    "KP_EXTRA_SLOW": 1.2,
    "TD_EXTRA_SLOW": 0.12,
    "N_EXTRA_SLOW": 12,
    "_comment_shared": "Shared — integral and timing constants",
    "TI": 40,
    "TI_DEADBAND": 30,
    "TI_MAX": 400,
    "DT": 0.01,
    "_comment_sr": "Speed reduction coefficients — split by speed mode",
    "V_RED_COEF": 3,
    "V_RED_COEF_SLOW": 2,
    "V_RED_COEF_EXTRA_SLOW": 0,
    "OUTPUT_CLAMP_RPM": 800,
    "SR_ALPHA": 0.15,
    "SR_CAP": 0.45
  },

  "can_sensor": {
    "SENSOR_COB_ID": 390,
    "FLAG_TAPE_DETECT": 2,
    "FLAG_LEFT_MARKER": 4,
    "FLAG_RIGHT_MARKER": 8,
    "FLAG_SENSOR_FAIL": 128,
    "CAN_TIMEOUT": 0.5,
    "CAN_NODE_ID": 6,
    "_comment_limits": "Reject |left_mm|>SENSOR_MAX_MM; clamp per-cycle jumps > SENSOR_MAX_STEP_MM",
    "SENSOR_MAX_MM": 100.0,
    "SENSOR_MAX_STEP_MM": 40.0
  },

  "rfid": {
    "RFID_INIT_CMD_HEX": "CFFF0070002415",
    "SEQUENCE_STOP_DELAY": 4.0
  },

  "encoder": {
    "_comment": "CANopen friction-wheel encoder for wheel-speed calibration. Multi-turn: TPDO1 maps 0x6004 (24-bit), wraps at TOTAL_RANGE not per-rev. WHEEL_DIAMETER_M is the encoder friction wheel contact diameter; v_ground = omega_enc * (WHEEL_DIAMETER_M/2).",
    "ENABLED": 1,
    "NODE_ID": 1,
    "BITRATE": 125000,
    "COUNTS_PER_REV": 4096,
    "TOTAL_RANGE": 16777216,
    "WHEEL_DIAMETER_M": 0.060,
    "TPDO_COB_ID_BASE": 384
  },

  "calibration": {
    "_comment": "Open-loop straight ramp for input-vs-actual wheel speed.",
    "V_START": 0.0,
    "V_STEP": 0.02,
    "V_MAX": 0.80,
    "DWELL_S": 4.0
  },

  "feedforward": {
    "_comment": "Curvature feedforward for corners: output_ff = sign*0.5*base_rpm*(TRACK_WIDTH_M/CURVE_RADIUS_M), applied while speed_mode is a curve mode. Stadium is CCW => all left turns.",
    "ENABLED": 1,
    "TRACK_WIDTH_M": 0.46,
    "CURVE_RADIUS_M": 1.5,
    "CURVE_DIRECTION": "left",
    "CURVE_SPEED_MODES": ["SLOW"],
    "FF_ALPHA": 0.15
  },

  "sequences": [
    {
      "_comment": "Slow down zone — RFID-only trigger",
      "name": "speed_zone_slow",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "0014" },
      "actions": [
        { "type": "set_speed", "speed": "SLOW" }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Resume high speed — RFID-only trigger",
      "name": "speed_zone_high",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "0016" },
      "actions": [
        { "type": "set_speed", "speed": "HIGH" }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Slow down zone (alt tag) — RFID-only trigger",
      "name": "speed_zone_slow_alt",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "001C" },
      "actions": [
        { "type": "set_speed", "speed": "SLOW" }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Timed checkpoint stop — RFID-only trigger",
      "name": "checkpoint_stop",
      "category": "sequence",
      "trigger": { "type": "rfid", "rfid_tag": "000C" },
      "actions": [
        { "type": "sequence_stop", "duration": 4.0 }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Trolley load 0 — RFID arms a SLOW curved approach (feedforward steers the corner); left marker then switches to EXTRA_SLOW straight crawl for a precise stop.",
      "name": "trolley_load_00",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "0096",
        "marker_side": "left",
        "approach_timeout": 15.0,
        "approach_speed": "SLOW"
      },
      "actions": [
        { "type": "set_speed",        "speed": "EXTRA_SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 30.0 },
        { "type": "wait_seconds",     "duration": 2.0 },
        { "type": "stop_agv" },
        { "type": "plc_request",      "seq_num": 0, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 0, "clear_timeout": 10.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_01",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "0098",
        "marker_side": "left",
        "approach_timeout": 15.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "EXTRA_SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 15.0 },
        { "type": "stop_agv" },
        { "type": "plc_request",      "seq_num": 1, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 1, "clear_timeout": 5.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_02",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "009A",
        "marker_side": "left",
        "approach_timeout": 15.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 15.0 },
        { "type": "stop_agv" },
        { "type": "plc_request",      "seq_num": 2, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 2, "clear_timeout": 5.0, "done_timeout": 30.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_03",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "009C",
        "marker_side": "left",
        "approach_timeout": 15.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 15.0 },
        { "type": "stop_agv" },
        { "type": "plc_request",      "seq_num": 3, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 3, "clear_timeout": 5.0, "done_timeout": 30.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_04",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "009E",
        "marker_side": "left",
        "approach_timeout": 15.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 15.0 },
        { "type": "stop_agv" },
        { "type": "plc_request",      "seq_num": 4, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 4, "clear_timeout": 5.0, "done_timeout": 30.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_05",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "00A0",
        "marker_side": "left",
        "approach_timeout": 15.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 15.0 },
